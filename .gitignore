# Public-site allowlist: keep work files out of Git.
*
!.gitignore
!.nojekyll
!README.md
!SKILL.md
!index.html
!search.html
!search-index.json
!sermons/
!sermons/*.html
!sermons/**/*.html
!archive.html
!archive/
!archive/*.html
!series.html
!series/
!series/*.html
!assets/
!assets/site.css
!content/
!content/sermons/
!content/sermons/*/
!content/sermons/*/*.json
!content/series/
!content/series/*.json
!site/
!site/*.py
!site/assets/
!site/assets/*.css
!site/assets/*.js
!tests/
!tests/*.py
!requirements-test.txt
!Makefile
